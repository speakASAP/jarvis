# jarvis — configuration names and safe examples only.
# Secret VALUES live only in Vault at secret/prod/jarvis and reach pods via
# k8s/external-secret.yaml. Never commit a value. Never create a plaintext Secret.

SERVICE_NAME="jarvis"
PORT="4870"
DOMAIN="jarvis.alfares.cz"

# --- Persistence (secret: DATABASE_URL) ---
# Dedicated database `jarvis`, least-privilege role `jarvis_app`.
DATABASE_URL="postgresql://jarvis_app:__FROM_VAULT__@db-server-postgres.statex-apps.svc.cluster.local:5432/jarvis"

# --- Object storage: immutable raw sources (secrets: MINIO_ACCESS_KEY/SECRET) ---
MINIO_ENDPOINT="http://minio-microservice.statex-apps.svc.cluster.local:9000"
MINIO_BUCKET="jarvis-raw"

# --- Ecosystem services (internal Kubernetes DNS) ---
AUTH_SERVICE_URL="http://auth-microservice.statex-apps.svc.cluster.local:3370"
AI_SERVICE_URL="http://ai-microservice.statex-apps.svc.cluster.local:3380"
LOGGING_SERVICE_URL="http://logging-microservice.statex-apps.svc.cluster.local:3367"
NOTIFICATIONS_SERVICE_URL="http://notifications-microservice.statex-apps.svc.cluster.local:3368"

# --- Auth application identity (secrets: JARVIS_CLIENT_ID/SECRET) ---
AUTH_PUBLIC_URL="https://auth.alfares.cz"
AUTH_RETURN_URL="https://jarvis.alfares.cz/auth/callback"

# --- Model access ---
# jarvis holds NO third-party provider key (INV-007). All model calls go
# through ai-microservice.
